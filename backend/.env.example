# ARTHAM backend environment variables
# Copy to .env and fill in real values for production

# Server port
PORT=3001

# Secret used to sign JWT access tokens (generate a long random string)
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret

# Secret used to sign JWT refresh tokens
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret

# Razorpay webhook secret (used to cryptographically verify webhook signatures)
RAZORPAY_WEBHOOK_SECRET=change-me-webhook-secret

# Comma separated list of allowed CORS origins
# Production: your app's actual domain only
APP_ORIGINS=http://localhost:5173,https://*.monkeycode-ai.live

# Access token lifetime in minutes
ACCESS_TOKEN_TTL=15

# Refresh token lifetime in days
REFRESH_TOKEN_TTL=7
